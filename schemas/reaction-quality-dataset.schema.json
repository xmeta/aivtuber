{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xmeta/aivtuber/schemas/reaction-quality-dataset.schema.json",
  "title": "AIVTuber Reaction Quality Evaluation Dataset",
  "description": "Versioned offline reaction-quality scenario dataset. Development and holdout partitions share one dataset identity but must not share leakage groups.",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "dataset_version",
    "partition",
    "partition_revision",
    "provenance",
    "compatibility",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "partition": {
      "type": "string",
      "enum": ["development", "holdout"]
    },
    "partition_revision": {
      "type": "integer",
      "minimum": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_kind",
        "authored_at",
        "contains_private_production_content"
      ],
      "additionalProperties": false,
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": ["synthetic", "public_curated"]
        },
        "authored_at": {
          "type": "string",
          "format": "date"
        },
        "contains_private_production_content": {
          "const": false
        },
        "source_reference": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "event_schema_version",
        "runtime_profile",
        "config_version",
        "persona_version",
        "route_policy_version"
      ],
      "additionalProperties": false,
      "properties": {
        "event_schema_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime_profile": {
          "type": "string",
          "minLength": 1
        },
        "config_version": {
          "type": "string",
          "minLength": 1
        },
        "persona_version": {
          "type": "string",
          "minLength": 1
        },
        "route_policy_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "holdout_policy": {
      "type": "object",
      "required": [
        "visibility",
        "rotation_generation",
        "case_level_feedback_used_for_tuning",
        "rotation_trigger"
      ],
      "additionalProperties": false,
      "properties": {
        "visibility": {
          "type": "string",
          "enum": ["repository_visible", "restricted_external"]
        },
        "rotation_generation": {
          "type": "integer",
          "minimum": 1
        },
        "case_level_feedback_used_for_tuning": {
          "const": false
        },
        "rotation_trigger": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "partition": {
            "const": "holdout"
          }
        },
        "required": ["partition"]
      },
      "then": {
        "required": ["holdout_policy"]
      }
    }
  ],
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "leakage_group",
        "category",
        "stimulus",
        "quality_dimensions",
        "reference"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "leakage_group": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$",
          "description": "Semantically equivalent or near-duplicate variants share one leakage group. Groups must not cross development and holdout."
        },
        "category": {
          "type": "string",
          "enum": [
            "common_chat",
            "question",
            "donation",
            "semantic_near_miss",
            "repetition_pressure",
            "fallback_generation",
            "silence_or_nonverbal",
            "interruption_context",
            "game_event",
            "system_health"
          ]
        },
        "stimulus": {
          "type": "object",
          "required": [
            "event_kind",
            "synthetic_summary",
            "context_tags"
          ],
          "additionalProperties": false,
          "properties": {
            "event_kind": {
              "type": "string",
              "enum": [
                "chat.message",
                "chat.donation",
                "speech.input",
                "game.event",
                "stream.event",
                "timer.tick",
                "operator.command",
                "system.health"
              ]
            },
            "synthetic_summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "context_tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
              }
            }
          }
        },
        "quality_dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "appropriateness",
              "semantic_correctness",
              "repetition",
              "timing",
              "personality_consistency",
              "interruption_quality",
              "silence_choice",
              "generation_necessity"
            ]
          }
        },
        "reference": {
          "type": "object",
          "required": [
            "ambiguity",
            "acceptable_route_classes",
            "known_unacceptable_traits"
          ],
          "additionalProperties": false,
          "properties": {
            "ambiguity": {
              "type": "string",
              "enum": ["low", "intentional", "unknown"]
            },
            "acceptable_route_classes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "deterministic",
                  "semantic_reuse",
                  "jev",
                  "generated",
                  "cached_fallback",
                  "non_verbal",
                  "silent"
                ]
              }
            },
            "known_unacceptable_traits": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "semantic_mismatch",
                  "stale_context",
                  "unsafe_content",
                  "repetitive_response",
                  "overreaction",
                  "underreaction",
                  "inappropriate_silence",
                  "unnecessary_generation",
                  "interrupts_higher_priority_action"
                ]
              }
            },
            "notes": {
              "type": ["string", "null"]
            }
          }
        }
      }
    }
  }
}
