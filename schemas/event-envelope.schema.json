{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xmeta/aivtuber/schemas/event-envelope.schema.json",
  "title": "AI VTuber Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "correlation_id",
    "sequence",
    "observed_at",
    "source",
    "kind",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "chat.message",
        "chat.donation",
        "speech.input",
        "game.event",
        "stream.event",
        "timer.tick",
        "operator.command",
        "system.health"
      ]
    },
    "actor_id": {
      "type": ["string", "null"]
    },
    "priority_hint": {
      "type": ["number", "null"],
      "minimum": 0.0,
      "maximum": 1.0
    },
    "payload": {
      "type": "object"
    }
  }
}
