{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xmeta/aivtuber/schemas/reaction-quality-review.schema.json",
  "title": "AIVTuber Reaction Quality Review Session",
  "description": "Versioned offline pairwise human-review evidence for reaction-quality evaluation. Individual votes and disagreement are retained; the document cannot mint runtime authority.",
  "type": "object",
  "required": [
    "schema_version",
    "review_session_id",
    "status",
    "dataset",
    "comparison",
    "protocol",
    "authority_effect",
    "contains_private_production_content",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1" },
    "review_session_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "status": { "type": "string", "enum": ["collecting", "complete"] },
    "dataset": {
      "type": "object",
      "required": ["dataset_id", "dataset_version", "partition", "partition_revision", "compatibility"],
      "additionalProperties": false,
      "properties": {
        "dataset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "dataset_version": { "type": "string", "minLength": 1 },
        "partition": { "type": "string", "enum": ["development", "holdout"] },
        "partition_revision": { "type": "integer", "minimum": 1 },
        "compatibility": { "$ref": "#/$defs/compatibility" }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["base", "candidate"],
      "additionalProperties": false,
      "properties": {
        "base": { "$ref": "#/$defs/policyIdentity" },
        "candidate": { "$ref": "#/$defs/policyIdentity" }
      }
    },
    "protocol": {
      "type": "object",
      "required": [
        "protocol_id",
        "protocol_version",
        "instructions_version",
        "identity_hidden_during_review",
        "randomization",
        "randomization_seed"
      ],
      "additionalProperties": false,
      "properties": {
        "protocol_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
        "protocol_version": { "type": "string", "minLength": 1 },
        "instructions_version": { "type": "string", "minLength": 1 },
        "identity_hidden_during_review": { "const": true },
        "randomization": { "const": "seeded_per_case" },
        "randomization_seed": { "type": "integer", "minimum": 0 }
      }
    },
    "authority_effect": {
      "const": "offline_evidence_only",
      "description": "Review labels are evidence only and cannot authorize runtime control, memory writes, publication, or policy promotion."
    },
    "contains_private_production_content": { "const": false },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reviewCase" }
    },
    "interpretation": {
      "type": "object",
      "required": ["quality_guardrail", "rationale", "decision"],
      "additionalProperties": false,
      "properties": {
        "quality_guardrail": {
          "type": "string",
          "enum": ["pass", "regression", "inconclusive"]
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "decision": {
          "type": "string",
          "enum": ["keep", "expand", "narrow", "revert", "defer", "stop"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "complete" } },
        "required": ["status"]
      },
      "then": { "required": ["interpretation"] }
    }
  ],
  "$defs": {
    "compatibility": {
      "type": "object",
      "required": [
        "event_schema_version",
        "runtime_profile",
        "config_version",
        "persona_version",
        "route_policy_version"
      ],
      "additionalProperties": false,
      "properties": {
        "event_schema_version": { "type": "string", "minLength": 1 },
        "runtime_profile": { "type": "string", "minLength": 1 },
        "config_version": { "type": "string", "minLength": 1 },
        "persona_version": { "type": "string", "minLength": 1 },
        "route_policy_version": { "type": "string", "minLength": 1 }
      }
    },
    "policyIdentity": {
      "type": "object",
      "required": ["revision", "policy_id", "config_version"],
      "additionalProperties": false,
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "policy_id": { "type": "string", "minLength": 1 },
        "config_version": { "type": "string", "minLength": 1 }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["route_class", "reaction_summary"],
      "additionalProperties": false,
      "properties": {
        "route_class": {
          "type": "string",
          "enum": [
            "deterministic",
            "semantic_reuse",
            "jev",
            "generated",
            "cached_fallback",
            "non_verbal",
            "silent"
          ]
        },
        "reaction_summary": { "type": "string", "minLength": 1, "maxLength": 1200 },
        "timing_note": { "type": ["string", "null"], "maxLength": 600 },
        "output_reference": {
          "type": ["string", "null"],
          "maxLength": 400,
          "description": "Optional opaque reviewer material reference. It must not encode route, policy, or base/candidate identity."
        }
      }
    },
    "presentation": {
      "type": "object",
      "required": ["a_role", "b_role"],
      "additionalProperties": false,
      "properties": {
        "a_role": { "type": "string", "enum": ["base", "candidate"] },
        "b_role": { "type": "string", "enum": ["base", "candidate"] }
      },
      "oneOf": [
        {
          "properties": {
            "a_role": { "const": "base" },
            "b_role": { "const": "candidate" }
          }
        },
        {
          "properties": {
            "a_role": { "const": "candidate" },
            "b_role": { "const": "base" }
          }
        }
      ]
    },
    "reviewCase": {
      "type": "object",
      "required": ["case_id", "category", "presentation", "candidates", "reviews"],
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "category": {
          "type": "string",
          "enum": [
            "common_chat",
            "question",
            "donation",
            "semantic_near_miss",
            "repetition_pressure",
            "fallback_generation",
            "silence_or_nonverbal",
            "interruption_context",
            "game_event",
            "system_health"
          ]
        },
        "presentation": { "$ref": "#/$defs/presentation" },
        "candidates": {
          "type": "object",
          "required": ["base", "candidate"],
          "additionalProperties": false,
          "properties": {
            "base": { "$ref": "#/$defs/candidate" },
            "candidate": { "$ref": "#/$defs/candidate" }
          }
        },
        "reviews": {
          "type": "array",
          "items": { "$ref": "#/$defs/review" }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["reviewer_id", "choice", "reason_labels", "dimension_labels"],
      "additionalProperties": false,
      "properties": {
        "reviewer_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "description": "Opaque reviewer identifier used only to preserve disagreement; do not encode reviewer performance scores."
        },
        "choice": {
          "type": "string",
          "enum": ["a_better", "b_better", "tie", "both_unacceptable"]
        },
        "reason_labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "appropriateness",
              "repetition",
              "semantic_error",
              "timing_naturalness",
              "personality_consistency",
              "unnecessary_generation",
              "silence_choice",
              "interruption_quality",
              "safety_policy"
            ]
          }
        },
        "dimension_labels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "preference"],
            "additionalProperties": false,
            "properties": {
              "dimension": {
                "type": "string",
                "enum": [
                  "appropriateness",
                  "semantic_correctness",
                  "repetition",
                  "timing",
                  "personality_consistency",
                  "interruption_quality",
                  "silence_choice",
                  "generation_necessity"
                ]
              },
              "preference": {
                "type": "string",
                "enum": [
                  "a_better",
                  "b_better",
                  "tie",
                  "both_unacceptable",
                  "not_applicable"
                ]
              }
            }
          }
        },
        "notes": { "type": ["string", "null"], "maxLength": 1000 }
      }
    }
  }
}
