# LLM and embedder selection for the Graphiti reference stack.
#
# LLM_PROVIDER / EMBEDDER_PROVIDER:
#   openai  = any OpenAI-compatible endpoint (OpenAI, OpenRouter, Ollama, vLLM)
#   gemini  = Gemini's native API (GEMINI_API_KEY or GOOGLE_API_KEY)
#
# Do not commit this file after filling in a real key. The repository ignores
# .env and .env.*; only .env.example is tracked.

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Used when the provider is Gemini and LLM_API_KEY is empty.
# GEMINI_API_KEY=

# A local Ollama deployment, for reference:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-oss:20b
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY=ollama
# LLM_STRUCTURED_OUTPUT=json_object
# LLM_MAX_TOKENS=8192

EMBEDDER_PROVIDER=openai
EMBEDDER_MODEL=text-embedding-3-small
EMBEDDER_BASE_URL=https://api.openai.com/v1
EMBEDDER_API_KEY=
# Must match the embedding model: 1536 for text-embedding-3-small,
# 1024 for gemini-embedding-001, 768 for nomic-embed-text, etc.
EMBEDDER_DIM=1536

# Graphiti's OpenAI logprob reranker is not used by the reference stack.
# Retrieval order is Graphiti's hybrid-search order; see README.adoc.
LLM_STRUCTURED_OUTPUT=json_schema
LLM_TEMPERATURE=0.0

FALKORDB_DATABASE=default_db
