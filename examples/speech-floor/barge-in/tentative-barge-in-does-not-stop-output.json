{
  "schema_version": "0.1.0",
  "name": "user speech over the performer that has not run barge_in_confirm_ms (400 ms) is tentative: nothing stops, whether it ends early or is still running (ADR-0005 D5, S-3; #81 S2)",
  "language": "ja",
  "backend": "fading",
  "barge_in": { "fade_ms": 120 },
  "steps": [
    { "now_ms": 0, "speak": { "duration_ms": 8000 } },
    {
      "now_ms": 1000,
      "beat": true,
      "vad": [{ "speaker_id": "mic-local", "edge": "start", "observed_at_ms": 1000 }]
    },
    {
      "now_ms": 1100,
      "beat": true,
      "service": true,
      "expect": { "record": null, "audio_stops": [], "avatar_resets": 0, "speaking": true, "pending_audio": 1, "yields_decided": 0 }
    },
    {
      "now_ms": 1300,
      "beat": true,
      "service": true,
      "expect": { "record": null, "audio_stops": [], "avatar_resets": 0, "speaking": true, "pending_audio": 1, "yields_decided": 0 }
    },
    {
      "now_ms": 1350,
      "beat": true,
      "vad": [{ "speaker_id": "mic-local", "edge": "end", "observed_at_ms": 1350 }]
    },
    {
      "now_ms": 1390,
      "beat": true,
      "service": true,
      "expect": { "record": null, "audio_stops": [], "avatar_resets": 0, "speaking": true, "pending_audio": 1, "yields_decided": 0 }
    },
    {
      "now_ms": 1700,
      "beat": true,
      "service": true,
      "expect": { "record": null, "audio_stops": [], "avatar_resets": 0, "speaking": true, "pending_audio": 1, "yields_decided": 0 }
    },
    {
      "now_ms": 3000,
      "beat": true,
      "service": true,
      "expect": { "record": null, "audio_stops": [], "avatar_resets": 0, "speaking": true, "pending_audio": 1, "yields_decided": 0 }
    }
  ]
}
