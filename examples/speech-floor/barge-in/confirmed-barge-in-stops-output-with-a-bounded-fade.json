{
  "schema_version": "0.1.0",
  "name": "a user speech run of barge_in_confirm_ms (400 ms) on a fresh feed stops the performer's speech at once (no wait for the end-of-speech interrupt point) with a fade of at most 150 ms, drops its pending commands and returns the avatar to neutral; it is acted on once (ADR-0005 S-3; #81 S2)",
  "language": "ja",
  "backend": "fading",
  "barge_in": { "fade_ms": 120 },
  "steps": [
    { "now_ms": 0, "speak": { "duration_ms": 8000 } },
    {
      "now_ms": 1000,
      "beat": true,
      "vad": [{ "speaker_id": "mic-local", "edge": "start", "observed_at_ms": 1000 }]
    },
    {
      "now_ms": 1399,
      "beat": true,
      "service": true,
      "expect": { "record": null, "audio_stops": [], "avatar_resets": 0, "speaking": true, "pending_audio": 1, "yields_decided": 0 }
    },
    {
      "now_ms": 1400,
      "beat": true,
      "service": true,
      "expect": {
        "record": {
          "effect": "Stopped",
          "decided_at_ms": 1400,
          "cancelled_playing": 1,
          "cancelled_queued": 0,
          "fade_ms": 120,
          "audio": "faded:120",
          "audio_error": false,
          "avatar_reset": true
        },
        "audio_stops": [120],
        "avatar_resets": 1,
        "speaking": false,
        "pending_audio": 0,
        "yields_decided": 1
      }
    },
    {
      "now_ms": 1410,
      "beat": true,
      "service": true,
      "expect": { "record": null, "audio_stops": [120], "avatar_resets": 1, "speaking": false, "pending_audio": 0, "yields_decided": 1 }
    },
    {
      "now_ms": 2500,
      "beat": true,
      "service": true,
      "expect": { "record": null, "audio_stops": [120], "avatar_resets": 1, "speaking": false, "pending_audio": 0, "yields_decided": 1 }
    }
  ]
}
