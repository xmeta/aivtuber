          {
            "kind": "screen_caption",
            "observation_id": "obs-h2",
            "source": {
              "alias": "game-main"
            },
            "frame": {
              "capture_seq": 2,
              "captured_at_ms": 150,
              "width": 768,
              "height": 432
            },
            "observed_at_ms": 250,
            "expires_at_ms": 20250,
            "producer": {
              "model_id": "qwen3-vl:4b-instruct-q4_k_m",
              "config_digest": "0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f",
              "prompt_version": "describe-v1"
            },
            "privacy": "private",
            "redaction": {
