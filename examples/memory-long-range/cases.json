        {
          "event_id": "evt-dislike",
          "actor": "viewer-1",
          "text": "viewer disliked game x",
          "topic": "game-x",
          "recorded_at_ms": 1000
        },
        {
          "event_id": "evt-enjoy",
          "actor": "viewer-1",
          "text": "viewer enjoyed the game x ending",
          "topic": "game-x",
          "recorded_at_ms": 2000,
          "supersedes": "evt-dislike"
        }
      ],
      "query": {
        "actor": "viewer-1",
        "topic": "game-x",
        "now_ms": 3000,
        "charged_bytes": 64
      },
      "must_deliver": ["evt-enjoy"],
      "must_not_deliver": ["evt-dislike"],
      "stale": ["evt-dislike"],
      "expected_delivery_order": ["evt-enjoy"]
    },
