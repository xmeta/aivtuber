<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>aivtuber local profile: third-party licences (Rust crates)</title>
<style>body{font-family:sans-serif;max-width:60em;margin:2em auto;padding:0 1em}pre{white-space:pre-wrap;font-size:.8em}</style>
</head>
<body>
<h1>Third-party licences: Rust crates linked into the bundled programs</h1>
<p>Generated by cargo-about from Cargo.lock for the release feature set. Engine libraries and the avatar page are covered in THIRD-PARTY-NOTICES.txt.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>Licence texts</h2>
<ul>
{{#each licenses}}
<li>
<h3 id="{{id}}">{{name}}</h3>
<h4>Used by</h4>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</li>
{{/each}}
</ul>
</body>
</html>
